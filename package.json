{
  "name": "@lbklauncher/dicebear-vyshyvanka",
  "version": "2.0.0",
  "description": "Vyshyvanka avatars: a DiceBear style of Ukrainian counted-thread ornaments built from one mirrored quarter",
  "author": {
    "name": "LBK Team",
    "email": "info@lbklauncher.com"
  },
  "license": "MIT",
  "homepage": "https://vyshyvanka.lbklauncher.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vadko/lbk-dicebear-vyshyvanka.git"
  },
  "keywords": [
    "dicebear",
    "avatar",
    "vyshyvanka",
    "ukrainian"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "build:site": "tsdown --config site/tsdown.config.ts",
    "build:style": "vitest run src/generator/buildVyshyvanka.test.ts --update && vitest run src/preview --update",
    "type-check": "tsc --noEmit && tsc --noEmit -p site",
    "format:check": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "prepublishOnly": "pnpm type-check && pnpm format:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@dicebear/core": "10.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@mobily/ts-belt": "3.13.1",
    "@types/culori": "4.0.1",
    "@types/node": "24.19.0",
    "culori": "4.0.2",
    "graphology": "0.26.0",
    "graphology-components": "1.5.4",
    "graphology-types": "0.24.8",
    "happy-dom": "21.0.4",
    "svgpath": "2.6.0",
    "transformation-matrix": "3.1.0",
    "tsdown": "0.23.4",
    "typescript": "6.0.3",
    "unist-util-visit-parents": "6.1.0",
    "vitest": "5.0.3"
  }
}
